[Desktop Entry]
Name=TukiGram
Comment=materialgram fork with extra privacy features
TryExec=tukigram
Exec=tukigram -- %U
Icon=io.github.pachdomenic.tukigram
Terminal=false
StartupWMClass=TukiGram
Type=Application
Categories=Chat;Network;InstantMessaging;Qt;
MimeType=x-scheme-handler/tg;x-scheme-handler/tonsite;x-scheme-handler/ton;
Keywords=tg;chat;im;messaging;messenger;sms;tdesktop;telegram;materialgram;tukigram
Actions=quit;
DBusActivatable=true
SingleMainWindow=true
X-GNOME-UsesNotifications=true
X-GNOME-SingleWindow=true

[Desktop Action quit]
Exec=tukigram -quit
Name=Quit TukiGram
Icon=application-exit
